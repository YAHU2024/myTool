<Window x:Class="QuickTranslate.UI.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="QuickTranslate 更新" Height="500" Width="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#16191F"
        Foreground="#F2F4F7"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuickTranslate;component/UI/SharedSettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="发现新版本" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

        <!-- 版本信息卡片 -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="当前版本"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CurrentVersionText"
                           Foreground="{StaticResource TextBrush}" FontSize="13"
                           Margin="4,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="最新版本"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="NewVersionText"
                           Foreground="{StaticResource PrimaryBrush}" FontSize="13"
                           FontWeight="SemiBold" Margin="4,0,0,0"/>
            </Grid>
        </Border>

        <!-- Changelog -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="4" Margin="0,0,0,14"
                Background="{StaticResource SurfaceBrush}">
            <Grid>
                <wv2:WebView2 x:Name="ChangelogBrowser"
                              Visibility="Collapsed"
                              Margin="10,6,10,14"
                              NavigationStarting="ChangelogBrowser_NavigationStarting"
                              NavigationCompleted="ChangelogBrowser_NavigationCompleted"/>

                <StackPanel x:Name="ChangelogStatusPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="340"
                            Margin="24"
                            AutomationProperties.Name="更新说明加载状态">
                    <ProgressBar x:Name="ChangelogLoadingBar"
                                 IsIndeterminate="True"
                                 Width="180" Height="3"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 Background="{StaticResource BorderBrush}"
                                 Margin="0,0,0,16"/>
                    <TextBlock x:Name="ChangelogStatusTitle"
                               Text="正在获取更新说明"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14" FontWeight="SemiBold"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="ChangelogStatusDetail"
                               Text="正在连接更新说明服务器，可直接点击「立即更新」开始安装。"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Button x:Name="OpenInBrowserButton"
                            Content="在浏览器中打开"
                            Width="120" Height="32"
                            Margin="0,16,0,0"
                            Visibility="Collapsed"
                            Click="OpenInBrowserButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4" Padding="14,6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OpenGitHubButton" Content="在 GitHub 中打开"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                    Click="OpenGitHubButton_Click"/>

            <Button x:Name="RemindLaterButton" Content="稍后提醒"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                    Click="RemindLaterButton_Click"/>

            <Button x:Name="UpdateButton" Content="立即更新"
                    Style="{StaticResource PrimaryButton}" Click="UpdateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
