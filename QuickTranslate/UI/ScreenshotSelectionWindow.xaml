<Window x:Class="QuickTranslate.UI.ScreenshotSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图翻译"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        AllowsTransparency="True"
        Background="#62000000"
        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Canvas x:Name="SelectionCanvas" Background="Transparent">
        <Border x:Name="SelectionBorder"
                Visibility="Collapsed"
                BorderBrush="#56B4FF"
                BorderThickness="2"
                Background="#183A86C8"
                IsHitTestVisible="False" />
        <Border x:Name="SelectionLabel"
                Visibility="Collapsed"
                Background="#E01E293B"
                Padding="8,4"
                CornerRadius="3"
                IsHitTestVisible="False">
            <TextBlock x:Name="SelectionLabelText"
                       Foreground="White"
                       FontSize="12"
                       FontFamily="Microsoft YaHei UI" />
        </Border>
        <TextBlock x:Name="HintText"
                   Canvas.Left="24"
                   Canvas.Top="24"
                   Foreground="White"
                   FontSize="14"
                   FontFamily="Microsoft YaHei UI"
                   Text="拖动鼠标框选截图区域，按 Esc 取消"
                   IsHitTestVisible="False" />
    </Canvas>
</Window>
