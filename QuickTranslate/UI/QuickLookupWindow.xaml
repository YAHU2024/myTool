<Window x:Class="QuickTranslate.UI.QuickLookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:QuickTranslate.Models"
        Title="快速查词"
        Width="420" Height="600" MinHeight="420" MaxHeight="600"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuickTranslate;component/UI/SharedToolWindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="PanelBackground" Color="#20232B"/>
        <SolidColorBrush x:Key="Surface" Color="#292E37"/>
        <SolidColorBrush x:Key="Border" Color="#414955"/>
        <SolidColorBrush x:Key="Text" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="Muted" Color="#AAB3BF"/>
        <SolidColorBrush x:Key="Accent" Color="#55C7BC"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#343B46"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#3E4854"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5,3"/><Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#303640"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="EnrichmentButton" TargetType="Button">
            <Setter Property="MinWidth" Value="112"/><Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="7,4"/><Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="#303640"/><Setter Property="BorderBrush" Value="#46515E"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#343B46"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#3E4854"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#303640"/><Setter TargetName="Surface" Property="BorderBrush" Value="#46515E"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Opacity" Value="0.72"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="5" Padding="18,14,18,12" CornerRadius="7" Background="{StaticResource PanelBackground}" BorderBrush="#48515D" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Opacity="0.48"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="23" Height="23" CornerRadius="5" Background="{StaticResource Accent}" VerticalAlignment="Center">
                    <TextBlock Text="Q" Foreground="#102B2A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="快速查词" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="关闭" AutomationProperties.Name="关闭快速查词" TabIndex="6" Click="CloseButton_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Height="44">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#8793A3" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="QueryTextBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" CaretBrush="{StaticResource Accent}" FontSize="14" VerticalContentAlignment="Center" TabIndex="0" AutomationProperties.Name="查词输入框" TextChanged="QueryTextBox_TextChanged"/>
                        <Button x:Name="SubmitButton" Grid.Column="2" Style="{StaticResource IconButton}" Width="34" Height="30" Content="&#xE72A;" ToolTip="查询" AutomationProperties.Name="查询" TabIndex="1" Click="SubmitButton_Click"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="InputHintText" Text="输入单词或短语" Foreground="#7F8A99" IsHitTestVisible="False" Margin="40,0,44,0" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="ResultScroller" Style="{StaticResource Win11ScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" Margin="0,90,0,0">
                            <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#66717F" HorizontalAlignment="Center"/>
                            <TextBlock Text="输入单词或短语开始查询" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" Margin="0,90,0,0">
                            <ProgressBar Height="3" IsIndeterminate="True" Foreground="{StaticResource Accent}" Background="#343A43"/>
                            <TextBlock Text="正在查询..." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="MessagePanel" Visibility="Collapsed" Margin="8,88,8,0">
                            <TextBlock x:Name="MessageTitle" Foreground="{StaticResource Text}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock x:Name="MessageBody" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,14"/>
                            <Button x:Name="RetryButton" Content="重试" Width="76" Height="32" HorizontalAlignment="Center" Background="#285A57" Foreground="White" BorderThickness="0" TabIndex="2" AutomationProperties.Name="重试查询" Click="RetryButton_Click"/>
                        </StackPanel>

                        <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="HeadwordText" Foreground="{StaticResource Text}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button x:Name="SpeakHeadwordButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="朗读词头" AutomationProperties.Name="朗读词头" TabIndex="3" Click="SpeakButton_Click"/>
                                <Button x:Name="CopyButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="复制查词结果" AutomationProperties.Name="复制查词结果" TabIndex="4" Click="CopyButton_Click"/>
                            </Grid>

                            <ItemsControl x:Name="PronunciationsItems" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:WordPronunciation}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                        <TextBlock Text="{Binding Region}" Foreground="#7F8A99" FontSize="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Phonetic}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Background="#3A414B" Margin="0,3,0,14"/>
                            <TextBlock Text="核心释义" Foreground="#8B96A5" FontSize="11" Margin="0,0,0,9"/>
                            <ItemsControl x:Name="SensesItems">
                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:WordSense}">
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{StaticResource Accent}" CornerRadius="3" Padding="6,2" Margin="0,0,9,0" VerticalAlignment="Top">
                                                <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding PartOfSpeech}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                <TextBlock Text="{Binding PartOfSpeech}" Foreground="#102B2A" FontWeight="SemiBold" FontSize="11"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Definition}" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Top">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Definition}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="{Binding EnglishDefinition}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl x:Name="ExamplesItems">
                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:WordExample}">
                                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Accent}" BorderThickness="3,0,0,0" CornerRadius="3" Padding="11,9" Margin="0,0,0,12">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="例句"/><Style.Triggers><DataTrigger Binding="{Binding Translation}" Value=""><Setter Property="Text" Value="英文例句"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Sentence}" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding Translation}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Translation}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE767;" Tag="{Binding Sentence}" ToolTip="朗读例句" AutomationProperties.Name="朗读例句" TabIndex="4" Click="SpeakButton_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel x:Name="CollocationsPanel" Margin="0,0,0,8">
                                <TextBlock Text="常用搭配" Foreground="#8B96A5" FontSize="11" Margin="0,0,0,7"/>
                                <ItemsControl x:Name="CollocationsItems">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Border Background="#303640" CornerRadius="4" Padding="9,5" Margin="0,0,7,7"><TextBlock Text="{Binding}" Foreground="{StaticResource Muted}" FontSize="11"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Grid Margin="0,2,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="EnrichButton" Style="{StaticResource EnrichmentButton}" Visibility="Collapsed" AutomationProperties.Name="AI 补全中文" Click="EnrichButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="EnrichButtonIcon" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="EnrichProgress" Visibility="Collapsed" IsIndeterminate="True" Width="14" Height="3" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource Accent}" Background="#46515E" BorderThickness="0"/>
                                        <TextBlock x:Name="EnrichButtonLabel" Text="AI 补全中文" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="SourceText" Grid.Column="1" Foreground="#74808E" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <Border x:Name="FeedbackBar" Panel.ZIndex="2" Visibility="Collapsed"
                        VerticalAlignment="Bottom" Margin="8" Padding="10,7"
                        Background="#343B46" BorderBrush="#56616F" BorderThickness="1" CornerRadius="4">
                    <TextBlock x:Name="FeedbackText" Foreground="{StaticResource Text}" FontSize="11" TextWrapping="Wrap"/>
                </Border>
            </Grid>

            <Border Grid.Row="3" BorderBrush="#353C46" BorderThickness="0,1,0,0" Padding="0,9,0,0" Margin="0,8,0,0">
                <DockPanel>
                    <TextBlock Text="最近" Foreground="#778291" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ItemsControl x:Name="RecentItems">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Tag="{Binding}" Style="{StaticResource RecentButton}" AutomationProperties.Name="{Binding StringFormat=重新查询 {0}}" Click="RecentButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
