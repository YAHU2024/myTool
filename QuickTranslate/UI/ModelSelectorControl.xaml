<UserControl x:Class="QuickTranslate.UI.ModelSelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             MinWidth="104"
             MaxWidth="260"
             Height="26">
    <Button x:Name="SelectorButton"
            Padding="8,2"
            Background="#34344A"
            BorderBrush="#50506A"
            BorderThickness="1"
            Foreground="#E8E8F0"
            ToolTipOpening="SelectorButton_ToolTipOpening"
            Click="SelectorButton_Click"
            AutomationProperties.Name="切换当前会话模型">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="NameViewport" Grid.Column="0" ClipToBounds="True" Margin="0,0,5,0">
                <TextBlock x:Name="ModelNameText"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="ModelNameTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Border>
            <TextBlock Grid.Column="1" FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE70D;" VerticalAlignment="Center"/>
        </Grid>
    </Button>
</UserControl>
