<Window x:Class="QuickTranslate.UI.ScreenshotTranslationProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="#EE1E293B"
            BorderBrush="#9956B4FF"
            BorderThickness="1"
            CornerRadius="4"
            Padding="16,12">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="StatusText"
                       Text="正在识别并翻译…"
                       Foreground="White"
                       FontSize="14"
                       FontFamily="Microsoft YaHei UI"
                       VerticalAlignment="Center" />
            <Button Content="取消"
                    Margin="16,0,0,0"
                    Padding="12,4"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Border>
</Window>
