<Window x:Class="QuickTranslate.UI.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickTranslate"
        WindowStyle="None"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Width="420"
        MinWidth="400"
        MaxWidth="900"
        MinHeight="120"
        MaxHeight="800"
        SizeToContent="Height"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuickTranslate;component/UI/SharedToolWindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="ToolbarButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#D7D7DE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#38384B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#4C4C63"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButton}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="ActiveTranslation">
                    <Setter Property="Background" Value="#4488FF"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="Tag" Value="ActiveCode">
                    <Setter Property="Background" Value="#FFA500"/>
                    <Setter Property="Foreground" Value="#1E1E2E"/>
                </Trigger>
                <Trigger Property="Tag" Value="ActiveTerm">
                    <Setter Property="Background" Value="#4EC9B0"/>
                    <Setter Property="Foreground" Value="#1E1E2E"/>
                </Trigger>
                <Trigger Property="Tag" Value="ActiveAnalysis">
                    <Setter Property="Background" Value="#7C3AED"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconToolbarButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ConversationNodeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Storyboard x:Key="LoadingDotsStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoadingDotOne" Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.4" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="LoadingDotTwo" Storyboard.TargetProperty="Opacity" From="0.3" To="1" BeginTime="0:0:0.13" Duration="0:0:0.4" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="LoadingDotThree" Storyboard.TargetProperty="Opacity" From="0.3" To="1" BeginTime="0:0:0.26" Duration="0:0:0.4" AutoReverse="True"/>
        </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#E81E1E2E" CornerRadius="8" Padding="12,8" Margin="4">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.5"/></Border.Effect>
        <!-- Footer rows are Auto so status/expand keep space; body (*) shrinks first when the window is short. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="TitleBar" Grid.Row="0" Margin="0,0,0,6" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="TranslationModeButton" Style="{StaticResource ModeButton}" Content="翻译" ToolTip="严格翻译" Click="ModeButton_Click" Tag="ActiveTranslation"/>
                    <Button x:Name="CodeModeButton" Style="{StaticResource ModeButton}" Content="命令" ToolTip="解释代码、配置或命令" Click="ModeButton_Click"/>
                    <Button x:Name="TermModeButton" Style="{StaticResource ModeButton}" Content="术语" ToolTip="解释技术术语" Click="ModeButton_Click"/>
                    <Button x:Name="AnalysisModeButton" Style="{StaticResource ModeButton}" Content="解析" ToolTip="深度解析" Click="ModeButton_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Content="&#x21BB;" FontSize="16" ToolTip="重新生成" Click="RefreshButton_Click"/>
                    <Button Style="{StaticResource IconToolbarButton}" Content="&#x29C9;" ToolTip="复制全部" Click="CopyAllButton_Click"/>
                    <Button x:Name="SpeakButton" Style="{StaticResource IconToolbarButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE768;" ToolTip="朗读结果" Click="SpeakButton_Click" IsEnabled="False" Opacity="0.45"/>
                    <Button x:Name="PinButton" Style="{StaticResource ToolbarButton}" Content="&#x1F4CC;" FontSize="13" ToolTip="固定窗口" Click="PinButton_Click"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" MinHeight="40" MaxHeight="780">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ConversationRailColumn" Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="ConversationNodeRail" Grid.Column="0" Margin="0,2,4,0" Visibility="Collapsed"/>
                <ScrollViewer x:Name="TranslationScroller" Grid.Column="1" Style="{StaticResource Win11ScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxWidth="870" MinHeight="40" ScrollChanged="TranslationScroller_ScrollChanged" PreviewMouseWheel="TranslationScroller_PreviewMouseWheel" PreviewKeyDown="TranslationScroller_PreviewKeyDown">
                    <StackPanel x:Name="ConversationContentPanel">
                        <TextBlock x:Name="AnalysisRootLabel" Text="解析" Foreground="#B7C5FF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" Visibility="Collapsed" Focusable="True" AutomationProperties.Name="初始解析"/>
                        <Grid x:Name="RootResultHost">
                            <TextBox x:Name="TranslationTextBlock" Foreground="#F0F0F0" FontSize="16" FontFamily="Microsoft YaHei UI" TextWrapping="Wrap" Padding="0,0,6,0" Text="" IsReadOnly="True" IsReadOnlyCaretVisible="False" Focusable="True" IsTabStop="False" AcceptsReturn="True" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" SelectionBrush="#4DB6AC" SelectionOpacity="0.45" Cursor="IBeam"/>
                            <RichTextBox x:Name="MarkdownDocumentHost" Visibility="Collapsed" IsReadOnly="True" IsReadOnlyCaretVisible="False" IsDocumentEnabled="True" Focusable="True" IsTabStop="False" BorderThickness="0" Background="Transparent" Padding="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" SelectionBrush="#4DB6AC" SelectionOpacity="0.45" Cursor="IBeam"/>
                        </Grid>
                        <StackPanel x:Name="AnalysisTurnsPanel" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
                <Border x:Name="LoadingIndicator" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" Background="#B01E1E2E" CornerRadius="4" Padding="6,3" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LoadingDotOne" Width="4" Height="4" Fill="#B7C5FF" Margin="1"/>
                        <Ellipse x:Name="LoadingDotTwo" Width="4" Height="4" Fill="#B7C5FF" Margin="1"/>
                        <Ellipse x:Name="LoadingDotThree" Width="4" Height="4" Fill="#B7C5FF" Margin="1"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="AnalysisFollowUpInput" Grid.Row="2" Margin="0,7,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="FollowUpTextBox" MinHeight="32" MaxLength="2000" Padding="9,5" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#F0F0F0" Background="#28283A" BorderBrush="#4A4A62" BorderThickness="1" TextChanged="FollowUpTextBox_TextChanged" AutomationProperties.Name="解析追问输入"/>
                    <TextBlock x:Name="FollowUpInputHint" Text="继续追问..." Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#85859A" FontFamily="Microsoft YaHei UI" FontSize="13" IsHitTestVisible="False"/>
                </Grid>
                <Button x:Name="FollowUpSendButton" Grid.Column="1" Style="{StaticResource IconToolbarButton}" Width="32" Height="32" Margin="6,0,0,0" FontFamily="Segoe MDL2 Assets" Content="&#xE724;" ToolTip="发送追问" AutomationProperties.Name="发送追问" Click="FollowUpSendButton_Click"/>
            </Grid>
            <Border x:Name="StatusMessageBar" Grid.Row="3" Margin="0,6,0,0" CornerRadius="4" Padding="8,4" Visibility="Collapsed" Background="#2A3348">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusMessageText" Grid.Column="0" FontFamily="Microsoft YaHei UI" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#B7C5FF" Text=""/>
                    <Button x:Name="StatusMessageActionButton" Grid.Column="1" Margin="8,0,0,0" Padding="6,1" FontSize="10" Style="{StaticResource ToolbarButton}" Background="#3E4B70" Content="" Visibility="Collapsed" Click="StatusMessageActionButton_Click"/>
                </Grid>
            </Border>
            <Button x:Name="ExpandMarkdownButton" Grid.Row="4" HorizontalAlignment="Right" Margin="0,4,0,0" Padding="6,2" FontSize="10" Style="{StaticResource ToolbarButton}" Background="#3E4B70" Content="展开全文" ToolTip="渲染完整结果" Visibility="Collapsed" Click="ExpandMarkdownButton_Click"/>
        </Grid>
    </Border>
</Window>
